{
  "name": "@corbits/google-tools",
  "version": "0.1.1",
  "description": "Corbits Google tools for Interchange, starting with Gmail.",
  "keywords": [
    "corbits",
    "gmail",
    "google",
    "interchange",
    "tools"
  ],
  "homepage": "https://github.com/corbitsdev/google-tools#readme",
  "bugs": {
    "url": "https://github.com/corbitsdev/google-tools/issues"
  },
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/google-tools.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sidecar-bundle": {
      "types": "./dist/sidecar-bundle.d.ts",
      "default": "./dist/sidecar-bundle.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test src",
    "test:e2e": "bun test e2e",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "arktype": "^2.2.3"
  },
  "devDependencies": {
    "@intx/agent": "0.4.0",
    "@intx/storage-isogit": "0.4.0",
    "@intx/types": "0.4.0",
    "@types/bun": "1.3.14",
    "@types/node": "22.10.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@intx/agent": "^0.4.0",
    "@intx/types": "^0.4.0"
  },
  "engines": {
    "node": ">=24"
  },
  "interchange": {
    "tools": "./dist/sidecar-bundle.js",
    "credentials": [
      {
        "handle": "gmail-api",
        "scopes": [
          "https://www.googleapis.com/auth/gmail.modify"
        ]
      }
    ]
  }
}
